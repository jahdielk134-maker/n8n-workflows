    {
      "parameters": {
        "jsCode": "// Liste d'exemple (Apple Notes n'est pas accessible automatiquement)\n// Pour tester le cas \"liste vide\", remplacez le tableau par : []\nconst articles = [\n  { nom: \"Spaghetti\", quantite: 2 },\n  { nom: \"Coquillettes\", quantite: 1 },\n  { nom: \"Oeufs\", quantite: 1 },\n  { nom: \"Spaghetti\", quantite: 1 },               // doublon -> fusionné en x3\n  { nom: \"Tomates\" },                              // sans quantité -> \"quantité à vérifier\"\n  { nom: \"Galette maison de mamie\", quantite: 1 }  // introuvable -> \"prix inconnu\"\n];\n\nreturn [{ json: { articles } }];"
      },
      "id": "c0000000-0000-4000-8000-000000000003",
      "name": "Liste d'exemple",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ ($json.articles || []).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c0000000-0000-4000-8000-000000000004",
      "name": "Liste vide ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "sendTo": "ton-adresse@example.com",
        "subject": "🛒 Ta liste de courses est vide",
        "emailType": "text",
        "message": "Ta liste est vide, pense à la remplir.",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "c0000000-0000-4000-8000-000000000005",
      "name": "Rappel liste vide",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        720,
        -80
      ],
      "credentials": {
        "gmailOAuth2": {
          "name": "Gmail account"
        }
