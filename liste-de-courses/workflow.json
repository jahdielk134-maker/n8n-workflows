    {
      "parameters": {
        "jsCode": "// On retrouve chaque article grâce à sa position (même ordre dans tous les nœuds)\nconst articles = $('Nettoyer la liste').all();\nconst prix = $input.all();\n\nlet total = 0;\nlet nbPrixInconnus = 0;\n\nconst lignes = articles.map((article, i) => {\n  const { nom, quantite, a_verifier } = article.json;\n\n  if (a_verifier) {\n    return `<li>${nom} – <em>quantité à vérifier</em></li>`;\n  }\n\n  const p = prix[i]?.json?.items?.[0]?.price;\n  if (p === undefined || p === null) {\n    nbPrixInconnus++;\n    return `<li>${nom} ×${quantite} – <em>prix inconnu</em></li>`;\n  }\n\n  total += p * quantite;\n  return `<li>${nom} ×${quantite}</li>`;\n});\n\nconst date = $now.setZone('Europe/Paris').toFormat('dd/MM/yyyy');\n\nconst html = `\n<h2>🛒 Courses de la semaine</h2>\n<ul>${lignes.join('')}</ul>\n<p><strong>Nombre d'articles :</strong> ${articles.length}<br>\n<strong>Coût total estimé :</strong> ${total.toFixed(2).replace('.', ',')} €</p>\n<p style=\"color:#888;font-size:12px\">Estimation approximative (source : Open Prices).\n${nbPrixInconnus ? nbPrixInconnus + ' article(s) sans prix, non compté(s) dans le total.' : ''}</p>`;\n\nreturn [{ json: { sujet: `Courses de la semaine – ${date}`, html } }];"
      },
