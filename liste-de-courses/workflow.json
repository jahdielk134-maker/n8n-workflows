        "subject": "⚠️ Alerte : liste de courses non envoyée",
        "emailType": "text",
        "message": "=La source de prix (Open Prices) ne répond pas. La liste de courses n'a pas été envoyée.\n\nDétail : {{ $json.error?.message || JSON.stringify($json.error) }}",
