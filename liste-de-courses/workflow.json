    {
      "parameters": {
        "jsCode": "// Règles des specs : fusion des doublons + articles incomplets marqués\nconst articles = $input.first().json.articles;\nconst fusion = new Map();\nconst aVerifier = [];\n\nfor (const a of articles) {\n  const nom = (a.nom || '').trim();\n  if (!nom) continue;\n  const quantite = Number(a.quantite);\n\n  // Quantité absente ou à 0 -> \"quantité à vérifier\"\n  if (!quantite || quantite <= 0) {\n    aVerifier.push(nom);\n    continue;\n  }\n\n  // Doublon -> on additionne les quantités\n  const cle = nom.toLowerCase();\n  if (fusion.has(cle)) fusion.get(cle).quantite += quantite;\n  else fusion.set(cle, { nom, quantite });\n}\n\n// 1 item = 1 article\nconst sortie = [...fusion.values()].map(a => ({ json: { ...a, a_verifier: false } }));\naVerifier.forEach(nom => sortie.push({ json: { nom, quantite: null, a_verifier: true } }));\nreturn sortie;"
      },
      "id": "c0000000-0000-4000-8000-000000000006",
      "name": "Nettoyer la liste",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        200
      ]
    },
    {
