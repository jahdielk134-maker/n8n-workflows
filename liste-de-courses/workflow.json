    {
      "parameters": {
        "errorMessage": "Source de prix indisponible : liste non envoyée."
      },
      "id": "c0000000-0000-4000-8000-000000000010",
      "name": "Arrêt (source de prix)",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1440,
        -80
      ]
