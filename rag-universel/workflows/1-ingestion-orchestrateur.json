    {
      "id": "76fdeb81-3f27-f748-5624-9fd19f9d3196",
      "name": "Détecter le format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Déduit le format du fichier envoyé (extension) et les choix du formulaire ; le fichier reste en binaire\nconst it = $input.first();\nconst b = (it.binary && it.binary.Fichier) || {};\nconst nom = b.fileName || '';\nconst ext = String(b.fileExtension || nom.split('.').pop() || '').toLowerCase();\nconst format = ext === 'pdf' ? 'pdf' : ext === 'csv' ? 'csv' : ['txt', 'md', 'markdown', 'text', 'html', 'htm', 'rtf'].includes(ext) ? 'texte' : 'inconnu';\nconst ocr = format === 'pdf' && /ocr/i.test(String(it.json[\"Mode d'extraction (PDF)\"] || ''));\nreturn [{ json: { ...it.json, extension: ext, nom_fichier: nom, format, ocr }, binary: it.binary }];"
      }
    },
    {
