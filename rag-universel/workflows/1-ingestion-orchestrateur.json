      "id": "8f067891-44fa-4798-82c2-218a4180d5ef",
      "name": "Format non géré",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const m = $input.first().json;\nthrow new Error('Type de fichier non géré : « ' + (m.extension || 'inconnu') + ' » (formats acceptés : PDF, TXT, MD, HTML, CSV, RTF). Aucune écriture dans la base.');"
      }
    },
    {
      "id": "8f922266-3978-cdf2-f662-bb9e0c225b84",
      "name": "Texte PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        -160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: { texte: String($input.first().json.text || '') } }];"
      }
    },
    {
      "id": "601bd61d-9508-b8dc-0b6c-55f816d06df2",
      "name": "Texte CSV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Chaque ligne du CSV devient un paragraphe « colonne : valeur ; colonne : valeur »\nconst lignes = $input.all().map(i => Object.entries(i.json).filter(([, v]) => v !== null && v !== '').map(([k, v]) => k + ' : ' + v).join(' ; '));\nreturn [{ json: { texte: lignes.join('\\n\\n') } }];"
      }
    },
    {
      "id": "1a73ca5f-51bd-7d27-477c-67a6a229bc2a",
      "name": "Texte TXT HTML RTF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Texte brut tel quel ; HTML : balises retirées ; RTF : codes de mise en forme retirés (heuristique)\nconst ext = $('Détecter le format').first().json.extension;\nlet t = String($input.first().json.data ?? $input.first().json.text ?? '');\nif (ext === 'html' || ext === 'htm') {\n  t = t.replace(/<(script|style)[\\s\\S]*?<\\/\\1>/gi, ' ')\n    .replace(/<\\/(p|div|h[1-6]|li|tr|section|article)>/gi, '\\n\\n').replace(/<br\\s*\\/?>/gi, '\\n').replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/&#39;|&apos;/g, \"'\");\n} else if (ext === 'rtf') {\n  t = t.replace(/\\\\pard?/g, '\\n').replace(/\\\\'([0-9a-f]{2})/gi, (_, h) => String.fromCharCode(parseInt(h, 16)))\n    .replace(/\\{\\\\\\*[^{}]*\\}/g, '').replace(/\\\\[a-z]+-?\\d* ?/gi, '').replace(/[{}]/g, '');\n}\nreturn [{ json: { texte: t } }];"
      }
    },
    {
      "id": "2c7d1c41-18a3-3d77-ee60-4aa69002dbed",
      "name": "Construire l'entrée (formulaire)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Entrée commune du pipeline : un item {texte, collection, titre, description, source, format, params}\nconst meta = $('Détecter le format').first().json;\nconst f = $('Formulaire').first().json;\nconst collection = String(f.Collection || '').trim();\nif (!collection) throw new Error('La collection est obligatoire');\nconst titre = String(f.Titre || '').trim() || meta.nom_fichier || 'Document';\nconst slug = s => s.normalize('NFD').replace(/\\p{M}/gu, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\nconst params = { taille: 1200, chevauchement: 150, min_chunks: 50, max_chunks: 300 };\n// mode démo / test : avec un nombre max de chunks, le plancher de 50 chunks ne s'applique plus (un petit document passe)\n// et le document reçoit une source « ::demo » distincte : un essai partiel ne peut jamais remplacer un document complet\nconst limite = Number(f['Nombre max de chunks (optionnel)']);\nif (limite > 0) { params.limite = limite; params.min_chunks = 1; }\nconst strat = String(f['Stratégie de chunking'] || '');\nif (/s[ée]mantique/i.test(strat)) params.strategie = 'semantique';\nelse if (/\\bIA\\b/.test(strat)) params.strategie = 'ia';\nconst entree = $input.first().json; // texte extrait (ou transcrit par l'OCR, auquel cas format = markdown)\nreturn [{ json: { texte: entree.texte, collection, titre, description: String(f.Description || '').trim(), source: slug(collection) + '::' + slug(titre) + (limite > 0 ? '::demo' : ''), format: entree.format || meta.format, params } }];"
      }
    },
    {
      "id": "e965f3ad-2698-c1fd-447e-743c6b1a613d",
      "name": "Webhook texte",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        560
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "rag-ingestion",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "23746099-f5c8-7104-aa45-1f8a0e0c1387",
      "name": "PDF en base64 ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        260,
        560
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "pb1",
              "leftValue": "={{ !!($json.body && $json.body.pdf_base64) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "6114ff48-84cf-7d6b-94fc-3340a09a5b11",
      "name": "Construire l'entrée (API)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        560
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Entrée par API : POST {collection, titre, description, texte | pdf_base64, strategie?, params?} ; même entrée commune que le formulaire\nconst b = $('Webhook texte').first().json.body || {};\nconst ocr = $input.first().json; // vient du webhook directement, ou de l'OCR (texte + format markdown)\nconst texte = ocr.texte !== undefined ? ocr.texte : b.texte;\nif (!texte || !b.collection || !b.titre) throw new Error('Champs obligatoires : collection, titre, et texte ou pdf_base64');\nconst slug = s => String(s).normalize('NFD').replace(/\\p{M}/gu, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\nconst params = { taille: 1200, chevauchement: 150, min_chunks: 50, max_chunks: 300, ...(b.params || {}) };\nif (b.strategie) params.strategie = b.strategie;\n// avec une limite (démo, test), la source est distincte : un essai partiel ne remplace jamais un document complet\nconst demo = Number(params.limite) > 0 ? '::demo' : '';\nreturn [{ json: { texte: String(texte), collection: String(b.collection).trim(), titre: String(b.titre).trim(), description: String(b.description || ''), source: slug(b.collection) + '::' + slug(b.titre) + demo, format: ocr.format || b.format || 'texte', params } }];"
      }
    },
    {
      "id": "dc505f8f-18d4-a315-1086-45181b8046bf",
      "name": "Préparer le PDF (OCR)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        -420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// OCR (1/3) : prépare le PDF (formulaire : fichier binaire ; API : champ pdf_base64) pour une transcription en Markdown par Gemini\nconst it = $input.first();\nlet b64; let origine;\nif (it.binary && it.binary.Fichier) {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'Fichier');\n  b64 = buf.toString('base64'); origine = 'formulaire';\n} else if (it.json.body && it.json.body.pdf_base64) {\n  b64 = String(it.json.body.pdf_base64).replace(/^data:.*?;base64,/, ''); origine = 'api';\n} else {\n  throw new Error('Aucun PDF à analyser pour l\\'OCR');\n}\nif (b64.length > 25000000) throw new Error('PDF trop volumineux pour l\\'OCR (limite : environ 18 Mo)');\nconst prompt = 'Transcris fidèlement ce document PDF en Markdown. Conserve la structure : titres (#, ##, ###) selon leur importance, paragraphes, listes à puces ou numérotées, tableaux Markdown. Ne résume rien, n\\'ajoute aucun commentaire, ne traduis pas. Omets les numéros de page et les en-têtes ou pieds de page qui se répètent. Réponds uniquement avec le Markdown, sans bloc de code autour.';\nreturn [{ json: { origine, pdf_b64: b64, prompt } }];"
      }
    },
    {
      "id": "a9ad4de0-ec1f-4fe8-9e64-b80a1aa962df",
      "name": "OCR Markdown (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1060,
        -420
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ inline_data: { mime_type: 'application/pdf', data: $json.pdf_b64 } }, { text: $json.prompt }] }], generationConfig: { temperature: 0, maxOutputTokens: 65536 } }) }}",
        "options": {
          "timeout": 600000
        }
      },
      "notes": "Credential à choisir : Google Gemini(PaLM) Api",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "47aa005b-b0ec-3d76-97f7-d28104b06df8",
      "name": "Texte OCR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// OCR (3/3) : récupère le Markdown renvoyé par Gemini ; refuse une transcription tronquée (indexer la moitié d'un document sans le dire serait pire qu'échouer)\nconst r = $input.first().json;\nconst cand = r.candidates && r.candidates[0];\nlet texte = ((cand && cand.content && cand.content.parts) || []).map(p => p.text || '').join('').trim();\nif (!texte) throw new Error('L\\'OCR n\\'a renvoyé aucun texte (' + ((cand && cand.finishReason) || 'réponse vide') + ')');\nif (cand.finishReason === 'MAX_TOKENS') throw new Error('OCR interrompu : le document est trop long pour une seule transcription (limite de sortie atteinte). Utilisez le mode « Rapide (texte) ».');\ntexte = texte.replace(/^```(?:markdown|md)?\\s*\\n/i, '').replace(/\\n```\\s*$/, '');\nconst origine = $('Préparer le PDF (OCR)').first().json.origine;\nreturn [{ json: { texte, format: 'markdown', origine } }];"
      }
    },
    {
      "id": "17279b9c-3532-008e-fabb-87029cef2c8e",
      "name": "Origine ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1580,
        -420
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "og1",
              "leftValue": "={{ $json.origine === 'api' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "18ca0b63-acdd-9169-fc3f-d32c062e5ada",
      "name": "Chunking",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [
        1580,
        280
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "RAG - Chunking (sous-workflow)"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "notes": "Sélectionner le sous-workflow : RAG - Chunking (sous-workflow)",
      "notesInFlow": true
    },
    {
      "id": "28937343-af83-2f1d-a332-8af4de8ed3d2",
      "name": "Contrôle du nombre de chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// GARDE-FOU : le pipeline attend entre min_chunks et max_chunks chunks (50 et 300 par défaut) ; en dehors, on arrête avant tout appel Gemini et toute écriture.\n// Avec params.limite (démo rapide), seuls les `limite` premiers chunks seront traités par le nœud Limit : le plafond max ne s'applique plus, le plancher oui.\nconst items = $input.all();\nconst p = (items[0] && items[0].json.params) || {};\nconst min = Number(p.min_chunks) || 50;\nconst max = Number(p.max_chunks) || 300;\nconst limite = Number(p.limite) || 0;\nconst n = items.length;\nif (limite) {\n  if (Math.min(n, limite) < min) throw new Error('Nombre de chunks hors limites : ' + Math.min(n, limite) + ' après limitation (minimum : ' + min + '). Aucune écriture dans la base.');\n} else if (n < min || n > max) {\n  throw new Error('Nombre de chunks hors limites : ' + n + ' (attendu : entre ' + min + ' et ' + max + '). Ajuster le document ou les paramètres (taille, bornes, nombre max de chunks). Aucune écriture dans la base.');\n}\nreturn items;"
      }
    },
    {
      "id": "eec85966-d1d4-5801-ced7-47a9d6da0f42",
      "name": "Limite de chunks",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        2100,
        280
      ],
      "parameters": {
        "maxItems": "={{ Number($json.params.limite) || $json.params.max_chunks || 300 }}",
        "keep": "firstItems"
      }
    },
    {
      "id": "74b3764d-4e75-d89d-afc2-8f89c733f30b",
      "name": "Augmentation",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [
        2360,
