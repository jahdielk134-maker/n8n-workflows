    {
      "id": "19afecac-6cca-5d56-ccaf-32d020d03ace",
      "name": "Préparer la recherche",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Rassemble ce dont le sous-workflow Recherche a besoin : configuration (collection, réglages) et routage (entités, mots-clés, requêtes) ; garde aussi l'historique pour l'agent\nconst cfg = $('Configuration').first().json;\nconst sel = $('Sélection').first().json.output;\nconst question = $('When chat message received').first().json.chatInput;\nlet historique = '';\ntry { historique = $('Formater l\\'historique').first().json.historique || ''; } catch (e) { historique = ''; }\nconst requetes = (sel.requetes || []).filter(Boolean).slice(0, 3);\nreturn [{ json: { requetes: requetes.length ? requetes : [question], questionOriginale: question, collection: cfg.collection, entites: sel.entites || [], mots_cles: sel.mots_cles || [], topK: cfg.topK, seuil: cfg.seuil, historique } }];"
      }
    },
