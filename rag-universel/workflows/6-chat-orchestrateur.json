        "operation": "executeQuery",
        "query": "WITH ins AS (INSERT INTO rag_messages (session_id, role, content) VALUES ($1, 'user', $2), ($1, 'assistant', $3) RETURNING id) SELECT count(*) AS enregistres FROM ins",
        "options": {
          "queryReplacement": "={{ [$('When chat message received').first().json.sessionId, $('When chat message received').first().json.chatInput, $json.output] }}"
        }
      },
      "notes": "Credential à choisir : Postgres (Supabase, Session pooler)",
      "onError": "continueRegularOutput"
