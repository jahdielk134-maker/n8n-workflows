    {
      "id": "0ac5a839-c5b1-f1e7-4302-afff04d35ba6",
      "name": "Formater l'historique",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        650,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Les 10 derniers messages de la session, du plus ancien au plus récent\nconst lignes = $input.all().map(i => i.json).filter(j => j.content).reverse();\nreturn [{ json: { historique: lignes.map(j => (j.role === 'user' ? 'Utilisateur' : 'Assistant') + ' : ' + String(j.content).slice(0, 600)).join('\\n') } }];"
      }
    },
    {
      "id": "61b23afd-f5f9-89a2-2dc5-0ab11bcd3a29",
      "name": "Sélection",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        780,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ ($json.historique ? 'Historique de la conversation (du plus ancien au plus récent) :\\n' + $json.historique + '\\n\\nSi le message est une relance qui dépend de l\\'historique (« résume », « et lui ? », « explique plus »), réintègre le sujet de la conversation dans les entités, les mots-clés et les requêtes, pour que la recherche se suffise à elle-même. Si le message n\\'a aucun rapport avec l\\'historique, ignore-le.\\n\\n' : '') + 'Message de l\\'utilisateur : ' + $('When chat message received').first().json.chatInput }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "Tu analyses un message envoyé à un assistant qui répond à partir d'une base de documents indexés. Tu ne réponds JAMAIS à la question toi-même : tu ne fais que l'analyser (routage), et tu n'inventes jamais de sujet qui n'est pas dans le message.\n\nChamps à renvoyer :\n- type : « salutation » si le message est vide, une simple salutation (bonjour, salut, hello, coucou), un remerciement ou ne contient aucune question ; sinon « question » (même si la question n'a aucun rapport avec les documents).\n- entites : les noms propres, personnes, organisations, lieux, œuvres cités dans le message (liste vide s'il n'y en a aucun). Ils servent de filtre.\n- mots_cles : 2 à 5 mots ou notions clés du message, au sens large (liste vide pour une salutation). Ils servent à classer les passages.\n- requetes : 1 à 3 reformulations de la question en français pour une recherche sémantique (la première reste proche de la question, les suivantes l'abordent sous un autre angle ou avec des synonymes ; garde les noms propres et supprime les formules de politesse). Liste vide pour une salutation.\n\nExemples :\n« Salut ! » → type salutation, entites [], mots_cles [], requetes []\n« Merci beaucoup » → type salutation, entites [], mots_cles [], requetes []\n« Que dit Sartre sur les autres ? » → type question, entites [« Sartre »], mots_cles [« autrui », « relation aux autres », « enfer »], requetes [« Sartre : position sur les autres », « le regard d'autrui et l'enfer chez Sartre »]\n« Quelle est la capitale de l'Australie ? » → type question, entites [« Australie »], mots_cles [« capitale », « Australie »], requetes [« capitale de l'Australie »]"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 4000
    },
    {
      "id": "e9d4bb89-40b7-58e5-9abd-19e7d861acb4",
