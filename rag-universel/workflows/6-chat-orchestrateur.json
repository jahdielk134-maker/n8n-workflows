    {
      "id": "d141c40b-f587-9e71-55a2-92873318b834",
      "name": "Agent de réponse",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        2340,
        360
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.questionOriginale }}",
        "options": {
          "systemMessage": "={{ 'Tu réponds en français, uniquement à partir des extraits de documents fournis. N\\'utilise aucune autre connaissance et n\\'invente rien. Tiens compte de la conversation en cours pour répondre (par exemple une demande de résumé). Rédige une réponse claire et concise. Termine par une section « Sources » qui liste, pour chaque extrait utilisé, le titre du document, le numéro de l\\'extrait et son entité principale (ligne « Entité principale », recopiée telle quelle, une seule), au format : Titre du document (extrait n° X) — entité principale. Ces informations figurent en tête de chaque extrait.' + ($('Préparer la recherche').first().json.historique ? '\\n\\nConversation en cours (du plus ancien au plus récent) :\\n' + $('Préparer la recherche').first().json.historique : '') + '\\n\\nExtraits :\\n\\n' + $json.contexte }}",
          "enableStreaming": false
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 4000
    },
