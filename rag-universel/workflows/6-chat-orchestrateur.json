    {
      "id": "6a114f70-34c8-d1c9-3d9f-106cc44ad0ca",
      "name": "Format de la sélection",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        920,
        240
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"type\":{\"type\":\"string\",\"enum\":[\"salutation\",\"question\"]},\"entites\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"mots_cles\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"requetes\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"type\",\"entites\",\"mots_cles\",\"requetes\"]}"
      }
    },
    {
      "id": "c27dc060-5835-cf8c-4551-03f80c8ab11f",
      "name": "Salutation ou message vide ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "conditions": {
          "combinator": "or",
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.output.type }}",
              "rightValue": "salutation",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c1b",
              "leftValue": "={{ /^\\s*(salut|bonjour|bonsoir|hello|hi|hey|coucou|merci|ok)?[\\s!.?]*$/i.test($('When chat message received').first().json.chatInput) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "8399a8c5-29c6-f8fb-4107-851a3cd2e0ac",
      "name": "Réponse d'accueil",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1300,
        -140
